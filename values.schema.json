{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Werte des hosted-Charts. Bewusst **ohne** additionalProperties: false - KCM schickt beim Anlegen Werte mit, die dieses Chart nicht liest (clusterIdentity, clusterLabels, clusterAnnotations), und eine neue KCM-Fassung kann weitere mitschicken. Ein fremder Schluessel wird deshalb angenommen und ignoriert; was dieses Chart liest, steht vollstaendig hier.",
  "required": ["clusterName", "region", "sshKeyName", "worker"],
  "properties": {
    "clusterName": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "sshKeyName": {
      "description": "Einer, nicht mehrere. Der standalone-Chart nimmt eine Liste `sshKeyNames` - wer die hier setzt, setzt nichts.",
      "type": "string",
      "minLength": 1
    },
    "hetznerSecretName": {
      "description": "Das Secret, auf das HetznerCluster.spec.hetznerSecretRef zeigt, auf dem regionalen Cluster. Nicht `tokenRef`: dessen Schluessel legt dieser Chart selbst auf `hcloud` fest.",
      "type": "string",
      "minLength": 1
    },
    "clusterNetwork": {
      "description": "`cidrBlock` im Singular je Netz. Der standalone-Chart nimmt `cidrBlocks` als Liste - wer die hier setzt, setzt nichts.",
      "type": "object",
      "properties": {
        "pods": {
          "type": "object",
          "properties": { "cidrBlock": { "type": "string", "minLength": 1 } }
        },
        "services": {
          "type": "object",
          "properties": { "cidrBlock": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "core": {
      "type": "object",
      "properties": {
        "serverType": {
          "type": "string",
          "minLength": 1
        },
        "imageName": {
          "type": "string"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "worker": {
      "type": "object",
      "required": ["serverType"],
      "properties": {
        "serverType": {
          "type": "string",
          "minLength": 1
        },
        "imageName": {
          "type": "string"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "etcd": {
      "type": "object",
      "properties": {
        "autoDeletePVCs": {
          "type": "boolean"
        }
      }
    },
    "k0s": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^v\\d+\\.\\d+\\.\\d+\\+k0s\\.\\d+$"
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minSize": { "type": "integer", "minimum": 0 },
        "maxSize": { "type": "integer", "minimum": 1 },
        "capacityHints": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          }
        }
      }
    },
    "clusterIdentity": {
      "description": "Von KCM mitgeschickt (der Verweis auf das Credential-Secret). Dieses Chart liest es nicht - der hosted-Dialekt nimmt `hetznerSecretName`.",
      "type": "object"
    },
    "clusterLabels": {
      "description": "Von KCM mitgeschickt, darunter die KOF-Labels. Dieses Chart liest sie nicht; sie stehen am ClusterDeployment.",
      "type": "object"
    },
    "clusterAnnotations": {
      "description": "Von KCM mitgeschickt. Dieses Chart liest sie nicht.",
      "type": "object"
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "apiHost": { "type": "string" },
        "konnectivityHost": { "type": "string" },
        "className": { "type": "string" },
        "port": { "type": "integer" },
        "annotations": { "type": "object" }
      },
      "if": {
        "properties": { "enabled": { "const": true } }
      },
      "then": {
        "required": ["apiHost", "konnectivityHost"],
        "properties": {
          "apiHost": { "minLength": 1 },
          "konnectivityHost": { "minLength": 1 }
        }
      }
    }
  }
}
